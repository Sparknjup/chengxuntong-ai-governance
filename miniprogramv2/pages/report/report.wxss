.report-page { padding-top: 34rpx; }.report-title { display: block; margin-top: 14rpx; font-size: 47rpx; line-height: 1.3; font-weight: 800; letter-spacing: -2rpx; }.report-title text { color: #d4693d; }.report-copy { display: block; margin-top: 14rpx; color: #858d87; font-size: 23rpx; }.form { margin-top: 34rpx; padding: 31rpx 27rpx; }.form-label { color: #29352f; font-size: 27rpx; font-weight: 800; }.form-gap { display: block; margin-top: 36rpx; }.type-wrap { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 18rpx; }.type { padding: 14rpx 19rpx; color: #738078; background: #f1f2ef; border-radius: 15rpx; font-size: 23rpx; }.type.selected { color: #c65d34; background: #fff0e8; font-weight: 700; }.upload { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; height: 190rpx; margin-top: 17rpx; color: #8d968f; background: #fbfaf8; border: 2rpx dashed #d7d4cd; border-radius: 21rpx; font-size: 22rpx; }.plus { margin-bottom: 4rpx; color: #cf6740; font-size: 44rpx; }.upload text:last-child { margin-top: 6rpx; color: #b3b8b3; font-size: 18rpx; }.fake-input { display: flex; flex-direction: column; justify-content: space-between; height: 140rpx; margin-top: 17rpx; padding: 20rpx; color: #a0a6a1; background: #f8f8f5; border-radius: 17rpx; font-size: 22rpx; }.fake-input text { align-self: flex-end; color: #c1c5c0; font-size: 19rpx; }.place { display: flex; align-items: center; gap: 15rpx; margin-top: 17rpx; padding: 18rpx; background: #f8f8f5; border-radius: 17rpx; }.place > text:first-child { display: flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; color: #cf6740; background: #fff0e6; border-radius: 50%; font-size: 27rpx; }.place view { display: flex; flex: 1; flex-direction: column; gap: 5rpx; font-size: 24rpx; font-weight: 700; }.place view text:last-child { color: #969e98; font-size: 19rpx; font-weight: 400; }.place > text:last-child { color: #a2aaa4; font-size: 40rpx; }.privacy { margin: 23rpx 8rpx; color: #939a95; font-size: 20rpx; }.submit { display: flex; align-items: center; justify-content: center; gap: 16rpx; height: 100rpx; color: #fff; background: linear-gradient(145deg, #df7143, #bd512d); border-radius: 26rpx; box-shadow: 0 14rpx 25rpx rgba(191,81,44,.22); font-size: 29rpx; font-weight: 800; }.submit text:last-child { font-size: 34rpx; }
