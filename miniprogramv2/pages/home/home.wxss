e; border: 1rpx solid rgba(255,249,241,.14); border-radius: 50%; }.shape-a { width: 380rpx; height: 380rpx; top: -158rpx; right: -110rpx; }.shape-b { width: 550rpx; height: 550rpx; top: -245rpx; right: -190rpx; }.hero-sun { position: absolute; top: 176rpx; right: 73rpx; width: 66rpx; height: 66rpx; background: #f9d08c; border-radius: 50%; box-shadow: 0 0 0 17rpx rgba(249,208,140,.12); }.content { padding-top: 0; }.quick { margin-top: -4rpx; padding: 31rpx 26rpx 29rpx; }.quick-copy { display: flex; flex-direction: column; gap: 9rpx; }.quick-copy text:last-child { color: #8c928c; font-size: 22rpx; }.problem-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 13rpx; margin-top: 27rpx; }.problem { display: flex; flex-direction: column; align-items: center; gap: 12rpx; color: #4b554f; font-size: 20rpx; }.problem-icon { display: flex; align-items: center; justify-content: center; width: 75rpx; height: 75rpx; border-radius: 24rpx; font-size: 36rpx; }.blue { color: #4979a7; background: #e8f2fc; }.orange { color: #ce6d37; background: #fff0e5; }.green { color: #41845d; background: #e5f4e8; }.purple { color: #7c639b; background: #f1ebf7; }.story { display: flex; gap: 20rpx; padding: 17rpx; }.story-art { position: relative; display: flex; align-items: center; justify-content: center; overflow: hidden; width: 172rpx; height: 178rpx; background: linear-gradient(150deg, #dceaca, #a8c18f); border-radius: 23rpx; color: #edb45d; font-size: 58rpx; }.story-art view { position: absolute; width: 230rpx; height: 64rpx; bottom: -25rpx; left: -35rpx; background: #739b70; border-radius: 50% 50% 0 0; transform: rotate(-8deg); }.story-info { display: flex; flex: 1; flex-direction: column; gap: 8rpx; padding: 5rpx 0; }.story-title { font-size: 27rpx; line-height: 1.35; font-weight: 800; }.story-desc { color: #838d86; font-size: 20rpx; line-height: 1.45; }.story-meta { margin-top: auto; color: #aaafa9; font-size: 18rpx; }.participation { display: flex; justify-content: space-betwee