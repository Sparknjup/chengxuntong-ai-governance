<view class="page orders-page"><view class="orders-head"><text class="eyebrow">MY CITY CONTRIBUTION</text><text class="orders-title">问题进度</text><text>你的每一次参与，都有回应。</text></view><view class="tabs"><text wx:for="{{tabs}}" wx:key="*this" data-tab="{{item}}" bindtap="filter" class="{{active === item ? 'on' : ''}}">{{item}}</text></view><view wx:for="{{visibleOrders}}" wx:key="id" class="ticket card" data-id="{{item.id}}" bindtap="detail"><view class="ticket-top"><text class="state {{item.status === '已完成' ? 'done' : 'processing'}}">{{item.stateText}}</text><text>{{item.date}}</text></view><view class="ticket-main"><view class="ticket-icon {{item.tone}}">{{item.icon}}</view><view><text>{{item.title}}</text><text>⌖ {{item.address}}</text></view></view><block wx:if="{{item.status === '处理中'}}"><view class="line"><view style="width: {{item.progress}}%;"></view></view><view class="steps"><text>已提交</text><text class="current">处理中</text><text>已完成</text></view></block><view wx:else class="finished">✓ 已完成处理 · 收获 {{item.reward}} 文明积分</view></view><view wx:if="{{visibleOrders.length === 0}}" class="empty-state">暂无{{active}}工单</view></view><view class="bottom-nav"><navigator class="nav" url="/pages/home/home" open-type="reLaunch"><text class="nav-icon">⌂</text><text>首页</text></navigator><navigator class="nav active" url="/pages/orders/orders"><text class="nav-icon">▤</text><text>进度</text></navigator><navigator class="nav nav-report" url="/pages/report/report"><text class="nav-icon">＋</text><text>上报</text></navigator><navigator class="nav" url="/pages/profile/profile"><text class="nav-icon">◉</text><text>我的</text></navigator></view>
