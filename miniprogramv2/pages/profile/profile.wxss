.profile { min-height: 100vh; padding-bottom: 164rpx; }.profile-hero { padding: calc(env(safe-area-inset-top) + 25rpx) 32rpx 39rpx; color: #fffaf2; background: linear-gradient(145deg, #334b40, #5c7862); border-radius: 0 0 54rpx 54rpx; }.hero-space { height: 26rpx; }.user-row { display: flex; align-items: center; }.avatar { display: flex; align-items: center; justify-content: center; width: 102rpx; height: 102rpx; color: #bd5e36; background: #faead1; border: 5rpx solid rgba(255,255,255,.2); border-radius: 34rpx; font-size: 42rpx; font-weight: 800; }.user-row view:nth-child(2) { display: flex; flex: 1; flex-direction: column; gap: 11rpx; margin-left: 20rpx; }.user-row view:nth-child(2) text:first-child { font-size: 34rpx; font-weight: 800; }.user-row view:nth-child(2) text:last-child { color: #c5d4c7; font-size: 21rpx; }.user-row > text { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; background: rgba(255,255,255,.12); border-radius: 17rpx; font-size: 30rpx; }.score { display: flex; justify-content: space-between; align-items: end; margin-top: 44rpx; }.score view { display: flex; flex-direction: column; }.score view:first-child text:first-child { color: #c7d5c8; font-size: 21rpx; }.score view:first-child text:last-child { margin-top: 2rpx; font-family: Georgia, serif; font-size: 69rpx; font-weight: 800; }.score view:last-child { align-items: end; gap: 10rpx; margin-bottom: 10rpx; }.score view:last-child text:first-child { padding: 8rpx 14rpx; color: #f6d79d; background: rgba(249,209,138,.13); border-radius: 100rpx; font-size: 19rpx; }.score view:last-child text:last-child { color: #c4d1c5; font-size: 17rpx; }.score-line { height: 8rpx; margin-top: 22rpx; background: rgba(255,255,255,.15); border-radius: 8rpx; }.score-line view { width: 56%; height: 100%; background: #f2c87d; border-radius: inherit; }.profile-body { padding: 0 24rpx; }.stats { display: flex; margin-top: -4rpx; padding: 28rpx 8rpx; }.stats view { display: flex; flex: 1; flex-direction: column; align-items: center; gap: 8rpx; border-right: 1rpx solid #efefea; }.stats view:last-child { border: 0; }.stats text:first-child { font-family: Georgia, serif; font-size: 37rpx; font-weight: 800; }.stats text:last-child { color: #8f9892; font-size: 19rpx; }.menu { margin-top: 24rpx; padding: 5rpx 24rpx; }.menu > view { display: flex; align-items: center; gap: 17rpx; padding: 24rpx 0; border-bottom: 1rpx solid #efefeb; }.menu > view:last-child { border: 0; }.menu-icon { display: flex; align-items: center; justify-content: center; width: 67rpx; height: 67rpx; border-radius: 21rpx; font-size: 30rpx; }.orange { color: #c75d35; background: #fff0e6; }.blue { color: #487ca5; background: #eaf2fb; }.green { color: #4a8961; background: #e8f4e9; }.menu > view > view { display: flex; flex: 1; flex-direction: column; gap: 7rpx; }.menu > view > view text:first-child { font-size: 26rpx; font-weight: 800; }.menu > view > view text:last-child { color: #99a19c; font-size: 19rpx; }.menu > view > text:last-child { color: #a5aaa6; font-size: 40rpx; }.quote { display: flex; gap: 12rpx; margin-top: 23rpx; padding: 25rpx; color: #547464; background: #e5efe3; border-radius: 27rpx; }.quote > text { color: #cb7050; font-family: Georgia, serif; font-size: 52rpx; line-height: 40rpx; }.quote view { display: flex; flex: 1; flex-direction: column; gap: 9rpx; }.quote text:first-child { font-size: 23rpx; line-height: 1.5; font-weight: 700; }.quote text:last-child { color: #829f8c; font-size: 18rpx; }
