.feedback-card { display: flex; flex-direction: column; gap: 18rpx; margin-top: 29rpx; padding: 28rpx; }.feedback-card > text { margin-top: 8rpx; font-size: 26rpx; font-weight: 800; }.feedback-types { display: flex; flex-wrap: wrap; gap: 13rpx; }.feedback-types text { padding: 13rpx 18rpx; color: #778179; background: #f0f1ee; border-radius: 15rpx; font-size: 21rpx; }.feedback-types .active { color: #bd5d36; background: #fff0e6; font-weight: 700; }.feedback-input { display: flex; flex-direction: column; justify-content: space-between; height: 190rpx; padding: 20rpx; color: #a2a8a3; background: #f8f8f5; border-radius: 18rpx; font-size: 22rpx; }.feedback-input text { align-self: flex-end; color: #bdc1bd; font-size: 18rpx; }.contact-input { padding: 20rpx; color: #a2a8a3; background: #f8f8f5; border-radius: 18rpx; font-size: 22rpx; }.feedback-submit { display: flex; align-items: center; justify-content: center; height: 96rpx; margin-top: 24rpx; color: #fff; background: #c66038; border-radius: 25rpx; font-size: 27rpx; font-weight: 800; }
