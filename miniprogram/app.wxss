page {
  min-height: 100%;
  background: #f6f8f7;
  color: #17211d;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

view, text { box-sizing: border-box; }

.page { padding: 24rpx 32rpx 176rpx; }
.safe-bottom { height: env(safe-area-inset-bottom); }
.section-title { font-size: 34rpx; font-weight: 700; letter-spacing: -1rpx; }
.section-subtitle { margin-top: 8rpx; color: #89938e; font-size: 24rpx; }
.card { background: #fff; border-radius: 32rpx; box-shadow: 0 12rpx 36rpx rgba(28, 54, 40, .06); }
.tag { display: inline-flex; align-items: center; padding: 8rpx 16rpx; border-radius: 100rpx; font-size: 22rpx; font-weight: 600; }
.tag-green { color: #13865a; background: #e5f7ed; }
.tag-orange { color: #be7013; background: #fff3df; }
.tag-blue { color: #3972a7; background: #eaf4ff; }

.bottom-nav {
  position: fixed; z-index: 10; right: 0; bottom: 0; left: 0;
  display: flex; align-items: center; justify-content: space-around;
  height: 132rpx; padding: 0 28rpx env(safe-area-inset-bottom);
  background: rgba(255,255,255,.96); box-shadow: 0 -8rpx 30rpx rgba(28, 54, 40, .06);
  backdrop-filter: blur(20px);
}
.nav-item { display: flex; flex: 1; flex-direction: column; align-items: center; gap: 6rpx; color: #89938e; font-size: 20rpx; }
.nav-icon { font-size: 34rpx; line-height: 38rpx; }
.nav-item.active { color: #14865b; font-weight: 700; }
.nav-report { position: relative; top: -28rpx; }
.nav-report .nav-icon { display: flex; align-items: center; justify-content: center; width: 94rpx; height: 94rpx; color: #fff; background: linear-gradient(135deg, #18aa74, #087f58); border: 8rpx solid #f6f8f7; border-radius: 50%; box-shadow: 0 10rpx 22rpx rgba(20, 134, 91, .28); font-size: 44rpx; }
.nav-report text:last-child { margin-top: -2rpx; }
