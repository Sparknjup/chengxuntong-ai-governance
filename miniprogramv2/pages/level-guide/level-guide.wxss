.level-current { display: flex; flex-direction: column; gap: 10rpx; margin-top: 28rpx; padding: 28rpx; color: #fff9ef; background: linear-gradient(145deg, #385849, #668269); border-radius: 28rpx; }.level-current text:first-child { color: #c6d4c7; font-size: 20rpx; }.level-current text:nth-child(2) { color: #f3d193; font-size: 31rpx; font-weight: 800; }.level-current text:last-child { font-size: 21rpx; }.level-list { margin-top: 23rpx; padding: 8rpx 24rpx; }.level-list > view { display: flex; align-items: center; gap: 17rpx; padding: 23rpx 0; border-bottom: 1rpx solid #efefeb; }.level-list > view:last-child { border: 0; }.level-list > view > text:first-child { color: #b5bab6; font-family: Georgia, serif; font-size: 29rpx; }.level-list > view > view { display: flex; flex: 1; flex-direction: column; gap: 6rpx; }.level-list > view > view text:first-child { font-size: 25rpx; font-weight: 800; }.level-list > view > view text:last-child, .level-list > view > text:last-child { color: #979e98; font-size: 19rpx; }.level-list .active > text:first-child, .level-list .active > text:last-child { color: #c8643a; }.rule-note { margin-top: 22rpx; padding: 22rpx; color: #6e7c73; background: #e8eee8; border-radius: 21rpx; font-size: 20rpx; text-align: center; }
