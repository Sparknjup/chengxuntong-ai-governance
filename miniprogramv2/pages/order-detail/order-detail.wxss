.detail-status { display: flex; flex-direction: column; gap: 9rpx; margin-top: 26rpx; padding: 25rpx; color: #a85f28; background: #fff0dc; border-radius: 24rpx; }.detail-status text:first-child { font-size: 29rpx; font-weight: 800; }.detail-status text:last-child { font-size: 20rpx; }.detail-card { display: flex; flex-direction: column; gap: 21rpx; margin-top: 21rpx; padding: 28rpx; }.detail-card > text { font-size: 28rpx; font-weight: 800; }.detail-card > view:not(.timeline) { display: flex; justify-content: space-between; color: #818a84; font-size: 22rpx; }.detail-card > view:not(.timeline) text:last-child { color: #2f3933; font-weight: 600; }.timeline { display: flex; gap: 16rpx; color: #9aa19c; }.timeline > text { color: #d5dad5; font-size: 25rpx; }.timeline view { display: flex; flex-direction: column; gap: 6rpx; }.timeline view text:first-child { color: #657069; font-size: 24rpx; font-weight: 700; }.timeline view text:last-child { font-size: 19rpx; }.timeline.active > text, .timeline.active view text:first-child { color: #c66238; }.detail-action { display: flex; align-items: center; justify-content: center; gap: 15rpx; height: 96rpx; margin-top: 24rpx; color: #fff; background: #c86036; border-radius: 25rpx; font-size: 28rpx; font-weight: 800; }
