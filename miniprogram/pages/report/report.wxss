.report-page { padding-top: 30rpx; }.intro { padding: 0 10rpx 32rpx; }.eyebrow { color: #159367; font-size: 20rpx; font-weight: 700; letter-spacing: 3rpx; }.page-title { display: block; margin-top: 13rpx; font-size: 48rpx; font-weight: 800; letter-spacing: -2rpx; }.page-title text { color: #139364; }.intro-copy { display: block; margin-top: 15rpx; color: #839089; font-size: 25rpx; }.form-card { padding: 34rpx 28rpx; }.field-label { color: #26342d; font-size: 27rpx; font-weight: 700; }.field-label text { color: #a0aaa5; font-size: 21rpx; font-weight: 400; }.gap-top { margin-top: 35rpx; }.type-list { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 19rpx; }.type-pill { padding: 14rpx 20rpx; color: #6e7b74; background: #f4f6f5; border-radius: 16rpx; font-size: 23rpx; }.type-pill.selected { color: #13845b; background: #e4f6ec; font-weight: 700; }.upload-row { display: flex; align-items: center; gap: 20rpx; margin-top: 17rpx; }.upload-box { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 155rpx; height: 155rpx; color: #7a8981; background: #f4f7f5; border: 2rpx dashed #c7d3cc; border-radius: 20rpx; font-size: 20rpx; }.upload-icon { color: #2b9d70; font-size: 43rpx; line-height: 48rpx; }.upload-tip { display: flex; flex-direction: column; gap: 8rpx; color: #89958f; font-size: 23rpx; }.upload-tip text:first-child { color: #48554e; font-size: 25rpx; font-weight: 700; }.textarea-placeholder { display: flex; flex-direction: column; justify-content: space-between; height: 160rpx; margin-top: 17rpx; padding: 20rpx; color: #a4ada8; background: #f7f9f8; border-radius: 18rpx; font-size: 23rpx; }.textarea-placeholder text { align-self: flex-end; color: #bcc4c0; font-size: 20rpx; }.location-field { display: flex; align-items: center; gap: 16rpx; margin-top: 17rpx; padding: 21rpx 18rpx; background: #f7f9f8; border-radius: 18rpx; }.pin { display: flex; align-items: center; justify-content: center; width: 50rpx; height: 50rpx; color: #168b60; background: #e2f5eb; border-radius: 50%; font-size: 30rpx; }.location-field view { display: flex; flex: 1; flex-direction: column; gap: 6rpx; font-size: 24rpx; font-weight: 700; }.location-field view text:last-child { color: #97a29c; font-size: 20rpx; font-weight: 400; }.arrow { color: #9daa9f; font-size: 40rpx; }.privacy { margin: 24rpx 8rpx; color: #93a099; font-size: 20rpx; }.privacy text { margin-right: 9rpx; color: #179066; }.submit { display: flex; justify-content: center; align-items: center; gap: 17rpx; height: 100rpx; color: #fff; background: linear-gradient(135deg, #14a26e, #087f58); border-radius: 26rpx; box-shadow: 0 16rpx 26rpx rgba(17,139,94,.22); font-size: 29rpx; font-weight: 700; }.submit text { font-size: 35rpx; }
