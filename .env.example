# ===================================
# 城讯通后端配置 - 复制此文件为 .env
# ===================================

# 应用配置
APP_NAME=城讯通后端系统
APP_ENV=development
DEBUG=True

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=chengxuntong

# JWT配置（生产环境务必修改SECRET_KEY）
JWT_SECRET_KEY=your-secret-key-please-change-in-production-use-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# AI接口配置
AI_API_URL=http://localhost:8000/analyze
AI_API_TIMEOUT=30
# 开发联调时，外部 AI 不可用则使用本地规则完成基础分类
AI_FALLBACK_ENABLED=True

# 文件上传
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=52428800

# 日志配置
LOG_DIR=logs
LOG_LEVEL=INFO

# 业务配置
POINTS_REPORT_VALID=5
POINTS_ORDER_CLOSED=8
POINTS_FIVE_STAR=3
POINTS_FALSE_REPORT=-10
