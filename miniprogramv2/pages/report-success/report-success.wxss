.success-page { display: flex; flex-direction: column; align-items: center; padding-top: 90rpx; }.success-mark { display: flex; align-items: center; justify-content: center; width: 116rpx; height: 116rpx; color: #fff; background: linear-gradient(145deg, #6c9476, #3e6b55); border-radius: 50%; box-shadow: 0 18rpx 35rpx rgba(62,107,85,.22); font-size: 54rpx; }.success-title { margin-top: 28rpx; font-size: 43rpx; font-weight: 800; }.success-copy { width: 590rpx; margin-top: 14rpx; color: #858e88; font-size: 23rpx; line-height: 1.65; text-align: center; }.receipt { width: 100%; margin-top: 36rpx; padding: 14rpx 27rpx; }.receipt view { display: flex; justify-content: space-between; padding: 21rpx 0; border-bottom: 1rpx solid #efefeb; color: #8a938d; font-size: 22rpx; }.receipt view:last-child { border: 0; }.receipt view text:last-child { color: #2f3b34; font-weight: 700; }.receipt .accent { color: #c86239; }.primary, .secondary { display: flex; align-items: center; justify-content: center; width: 100%; height: 96rpx; border-radius: 25rpx; font-size: 27rpx; font-weight: 800; }.primary { margin-top: 28rpx; color: #fff; background: #c85e35; }.secondary { margin-top: 14rpx; color: #59645e; background: #ebece8; }
