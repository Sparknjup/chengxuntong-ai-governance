<view class="page sub-page"><text class="eyebrow">ORDER NO. {{detail.no}}</text><text class="sub-title">{{detail.title}}</text><view class="detail-status"><text>{{detail.status}}</text><text>{{detail.note}}</text></view><view class="detail-card card"><text>问题信息</text><view><text>问题类型</text><text>{{detail.type}}</text></view><view><text>发生地点</text><text>{{detail.address}}</text></view><view><text>提交时间</text><text>{{detail.time}}</text></view></view><view class="detail-card card"><text>处理进度</text><view class="timeline"><text>✓</text><view><text>问题已提交</text><text>{{detail.time}}</text></view></view><view class="timeline active"><text>●</text><view><text>{{detail.status}}</text><text>{{detail.department}} · {{detail.step}}</text></view></view></view><view class="detail-action" bindtap="action">{{detail.status === '处理完成' ? '查看处理结果' : '催办工单'}} <text>→</text></view></view>
