.orders-page { padding-top: calc(env(safe-area-inset-top) + 34rpx); }.page-title { display: block; font-size: 48rpx; font-weight: 800; letter-spacing: -2rpx; }.subtitle { display: block; margin-top: 12rpx; color: #87928c; font-size: 24rpx; }.filter { display: flex; gap: 18rpx; margin: 34rpx 0 22rpx; }.filter text { padding: 15rpx 28rpx; color: #77837c; background: #edf1ef; border-radius: 100rpx; font-size: 24rpx; }.filter .active { color: #fff; background: #188e62; font-weight: 700; }.order-card { margin-bottom: 20rpx; padding: 27rpx; }.order-top, .order-main { display: flex; align-items: center; justify-content: space-between; }.order-time { color: #a2aaa6; font-size: 21rpx; }.order-main { justify-content: flex-start; gap: 18rpx; margin-top: 24rpx; }.order-thumb { display: flex; align-items: center; justify-content: center; width: 89rpx; height: 89rpx; background: #fff3d8; border-radius: 22rpx; font-size: 43rpx; }.order-thumb.clean { background: #e4f4e8; }.order-main view:last-child { display: flex; flex-direction: column; gap: 12rpx; }.order-title { font-size: 28rpx; font-weight: 700; }.order-address { color: #909b95; font-size: 21rpx; }.progress { margin-top: 28rpx; padding-top: 22rpx; border-top: 1rpx solid #eef1ef; }.progress-line { height: 7rpx; background: #e9eeeb; border-radius: 10rpx; }.progress-line view { width: 61%; height: 100%; background: linear-gradient(90deg, #1fac75, #77d7a2); border-radius: inherit; }.progress > view:last-child { display: flex; justify-content: space-between; margin-top: 10rpx; color: #9aa49f; font-size: 18rpx; }.progress > view:last-child text:nth-child(2) { color: #188e62; }.order-result { margin-top: 22rpx; padding: 15rpx 18rpx; color: #21825d; background: #eaf7ef; border-radius: 15rpx; font-size: 22rpx; }
