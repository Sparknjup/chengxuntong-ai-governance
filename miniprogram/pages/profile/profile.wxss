.profile-page { min-height: 100vh; padding-bottom: 170rpx; }.profile-hero { padding: calc(env(safe-area-inset-top) + 20rpx) 32rpx 38rpx; color: #fff; background: linear-gradient(145deg, #173c30, #1f6e51); border-radius: 0 0 56rpx 56rpx; }.top-space { height: 28rpx; }.profile-main { display: flex; align-items: center; }.avatar { display: flex; align-items: center; justify-content: center; width: 106rpx; height: 106rpx; color: #157f5a; background: linear-gradient(145deg, #f7fee7, #b4efce); border: 5rpx solid rgba(255,255,255,.25); border-radius: 38rpx; font-size: 44rpx; font-weight: 800; }.profile-name { display: flex; flex: 1; flex-direction: column; gap: 12rpx; margin-left: 21rpx; }.profile-name text:first-child { font-size: 35rpx; font-weight: 700; }.profile-name text:last-child { color: #b8d7c8; font-size: 22rpx; }.setting { display: flex; align-items: center; justify-content: center; width: 60rpx; height: 60rpx; background: rgba(255,255,255,.12); border-radius: 18rpx; font-size: 31rpx; }.points { display: flex; justify-content: space-between; align-items: flex-end; margin-top: 44rpx; }.points > view { display: flex; flex-direction: column; }.points-label { color: #b9d7c8; font-size: 22rpx; }.points-value { margin-top: 2rpx; font-size: 70rpx; font-weight: 800; letter-spacing: -2rpx; }.level { align-items: flex-end; gap: 10rpx; margin-bottom: 10rpx; }.level text:first-child { padding: 9rpx 15rpx; color: #d6f7e4; background: rgba(121,214,164,.18); border-radius: 100rpx; font-size: 20rpx; }.level text:last-child { color: #b9d7c8; font-size: 18rpx; }.points-progress { height: 8rpx; margin-top: 23rpx; background: rgba(255,255,255,.16); border-radius: 10rpx; }.points-progress view { width: 56%; height: 100%; background: #8be2b0; border-radius: inherit; }.profile-body { padding: 0 24rpx; }.data-card { display: flex; justify-content: space-around; margin-top: -5rpx; padding: 28rpx 12rpx; }.data-card view { display: flex; flex: 1; flex-direction: column; align-items: center; gap: 8rpx; border-right: 1rpx solid #edf0ee; }.data-card view:last-child { border: 0; }.data-card text:first-child { color: #1c392d; font-size: 37rpx; font-weight: 800; }.data-card text:last-child { color: #8b9790; font-size: 20rpx; }.menu-card { margin-top: 25rpx; padding: 6rpx 24rpx; }.menu-item { display: flex; align-items: center; gap: 18rpx; padding: 24rpx 0; border-bottom: 1rpx solid #eff2f0; }.menu-item:last-child { border: none; }.menu-icon { display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; border-radius: 21rpx; font-size: 30rpx; }.mint { color: #188b60; background: #e4f6eb; }.blue { color: #4781b3; background: #e8f4ff; }.yellow { color: #bd821e; background: #fff3db; }.menu-item view:nth-child(2) { display: flex; flex: 1; flex-direction: column; gap: 7rpx; }.menu-item view:nth-child(2) text:first-child { font-size: 27rpx; font-weight: 700; }.menu-item view:nth-child(2) text:last-child { color: #9ba59f; font-size: 20rpx; }.menu-item > text:last-child { color: #a7b0ab; font-size: 42rpx; }.join-card { display: flex; flex-direction: column; gap: 10rpx; margin-top: 25rpx; padding: 29rpx; color: #447360; background: linear-gradient(135deg, #dff5e6, #f0f9df); border-radius: 28rpx; }.join-card text:first-child { color: #297452; font-size: 29rpx; font-weight: 700; }.join-card text:last-child { font-size: 21rpx; }
