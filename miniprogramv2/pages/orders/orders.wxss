.orders-page { padding-top: calc(env(safe-area-inset-top) + 35rpx); }.orders-title { display: block; margin-top: 12rpx; font-size: 48rpx; font-weight: 800; letter-spacing: -2rpx; }.orders-head > text:last-child { display: block; margin-top: 12rpx; color: #858e88; font-size: 23rpx; }.tabs { display: flex; gap: 15rpx; margin: 35rpx 0 22rpx; }.tabs text { padding: 14rpx 27rpx; color: #7e8781; background: #ecece8; border-radius: 100rpx; font-size: 23rpx; }.tabs .on { color: #fff; background: #c96037; font-weight: 700; }.ticket { margin-bottom: 20rpx; padding: 26rpx; }.ticket-top { display: flex; justify-content: space-between; align-items: center; color: #a2a8a3; font-size: 20rpx; }.state { padding: 8rpx 14rpx; border-radius: 100rpx; font-size: 20rpx; font-weight: 700; }.processing { color: #b96a22; background: #fff2dc; }.done { color: #438065; background: #e6f4e9; }.ticket-main { display: flex; align-items: center; gap: 17rpx; margin-top: 23rpx; }.ticket-icon { display: flex; align-items: center; justify-content: center; width: 84rpx; height: 84rpx; border-radius: 23rpx; font-size: 39rpx; }.light { color: #cf6c36; background: #fff0e3; }.clean { color: #4c8d65; background: #e4f3e7; }.ticket-main view:last-child { display: flex; flex-direction: column; gap: 10rpx; }.ticket-main view:last-child text:first-child { font-size: 27rpx; font-weight: 800; }.ticket-main view:last-child text:last-child { color: #929b95; font-size: 20rpx; }.line { height: 7rpx; margin-top: 28rpx; background: #ebece8; border-radius: 10rpx; }.line view { width: 58%; height: 100%; background: linear-gradient(90deg, #de7042, #efaf76); border-radius: inherit; }.steps { display: flex; justify-content: space-between; margin-top: 10rpx; color: #a2aaa4; font-size: 18rpx; }.steps .current { color: #cf663a; font-weight: 700; }.finished { margin-top: 23rpx; padding: 14rpx 17rpx; color: #4c7f62; background: #eaf5ec; border-radius: 14rpx; font-size: 21rpx; }
