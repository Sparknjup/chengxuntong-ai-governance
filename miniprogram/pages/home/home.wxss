.home-page { padding: 0 0 172rpx; }
.hero { position: relative; overflow: hidden; min-height: 610rpx; padding: calc(env(safe-area-inset-top) + 28rpx) 32rpx 46rpx; color: #fff; background: linear-gradient(145deg, #0d845b 0%, #15a86f 62%, #44c784 100%); border-radius: 0 0 54rpx 54rpx; }
.topbar, .location, .hero-title, .hero-copy, .report-cta { position: relative; z-index: 1; }
.topbar { display: flex; justify-content: space-between; align-items: center; }.brand { display: flex; align-items: center; gap: 12rpx; font-size: 31rpx; font-weight: 700; }.brand-mark { display: flex; align-items: center; justify-content: center; width: 44rpx; height: 44rpx; background: #fff; border-radius: 14rpx; color: #109265; font-family: Georgia, serif; font-size: 31rpx; }.notice { display: flex; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; background: rgba(255,255,255,.15); border: 1rpx solid rgba(255,255,255,.23); border-radius: 18rpx; font-size: 35rpx; }
.location { display: inline-flex; gap: 9rpx; align-items: center; margin-top: 54rpx; padding: 11rpx 18rpx; background: rgba(5, 74, 49, .16); border-radius: 100rpx; font-size: 23rpx; }.chevron { margin-left: 4rpx; opacity: .75; }
.hero-title { width: 560rpx; margin-top: 25rpx; font-size: 53rpx; line-height: 1.28; font-weight: 800; letter-spacing: -2rpx; }.hero-title text { display: block; }.hero-copy { margin-top: 16rpx; opacity: .82; font-size: 25rpx; }
.report-cta { display: flex; justify-content: space-between; align-items: center; margin-top: 42rpx; padding: 25rpx 25rpx 25rpx 30rpx; color: #125c42; background: #fff; border-radius: 26rpx; box-shadow: 0 18rpx 30rpx rgba(0, 73, 46, .14); }.cta-eyebrow { display: block; color: #78aa97; font-size: 18rpx; letter-spacing: 2rpx; }.cta-title { display: block; margin-top: 5rpx; font-size: 31rpx; font-weight: 700; }.cta-arrow { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; color: #fff; background: #129666; border-radius: 50%; font-size: 36rpx; }
.hero-orb { position: absolute; border: 1rpx solid rgba(255,255,255,.12); border-radius: 50%; }.orb-one { width: 360rpx; height: 360rpx; top: -130rpx; right: -110rpx; }.orb-two { width: 520rpx; height: 520rpx; top: -210rpx; right: -190rpx; }
.quick-card { margin: -4rpx 24rpx 0; padding: 34rpx 28rpx 30rpx; }.quick-head, .section-row { display: flex; align-items: center; justify-content: space-between; }.all-link { color: #169365; font-size: 24rpx; }.category-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28rpx 12rpx; margin-top: 30rpx; }.category { display: flex; flex-direction: column; align-items: center; gap: 12rpx; color: #4e5b54; font-size: 23rpx; }.category-icon { display: flex; align-items: center; justify-content: center; width: 80rpx; height: 80rpx; border-radius: 26rpx; font-size: 37rpx; }.mint { background: #e8f8ef; }.yellow { background: #fff6df; }.blue { background: #eaf5ff; }.green { background: #ebf8eb; }.purple { background: #f3edfc; }.plain { color: #5e6d65; background: #f0f3f1; font-size: 22rpx; font-weight: 700; }
.section-row { margin: 46rpx 32rpx 22rpx; }.impact-card { position: relative; overflow: hidden; display: flex; align-items: center; margin: 0 24rpx; padding: 31rpx 30rpx; color: #fff; background: #233d31; border-radius: 30rpx; }.impact-number { font-size: 57rpx; font-weight: 800; }.impact-number text { margin-left: 6rpx; font-size: 25rpx; font-weight: 400; }.impact-copy { display: flex; flex: 1; flex-direction: column; gap: 9rpx; margin-left: 23rpx; font-size: 23rpx; }.impact-copy text:last-child { color: #9dcaaf; font-size: 20rpx; }.impact-line { position: absolute; right: -15rpx; bottom: 0; width: 150rpx; height: 46rpx; border-top: 4rpx solid #5dc58e; border-radius: 50% 50% 0 0; transform: rotate(-14deg); }
.news-card { display: flex; align-items: center; margin: 22rpx 24rpx; padding: 18rpx; }.news-thumb { display: flex; align-items: center; justify-content: center; width: 114rpx; height: 114rpx; background: linear-gradient(135deg, #cbeed6, #f0e7b4); border-radius: 22rpx; font-size: 53rpx; }.news-body { display: flex; flex: 1; flex-direction: column; gap: 9rpx; margin-left: 20rpx; }.news-title { font-size: 26rpx; font-weight: 700; }.news-meta { color: #9aa39e; font-size: 20rpx; }.news-arrow { color: #a5b1aa; font-size: 42rpx; }
