.score-card { position: relative; overflow: hidden; display: flex; flex-direction: column; gap: 18rpx; margin-top: 28rpx; padding: 31rpx; color: #fff9f1; background: linear-gradient(135deg, #315144, #56735e); border-radius: 30rpx; }.score-card > view:first-child { display: flex; flex-direction: column; gap: 5rpx; }.score-card > view:first-child text:first-child { color: #c7d5c9; font-size: 21rpx; }.score-card > view:first-child text:nth-child(2) { font-family: Georgia, serif; font-size: 66rpx; font-weight: 800; }.score-card > view:first-child text:last-child { color: #f2ce8d; font-size: 20rpx; }.score-card > view:nth-child(2) { display: flex; justify-content: space-between; color: #cfdbcf; font-size: 20rpx; }.score-progress { height: 8rpx; background: rgba(255,255,255,.16); border-radius: 9rpx; }.score-progress view { width: 57%; height: 100%; background: #f2c97d; border-radius: inherit; }.point-row { display: flex; align-items: center; justify-content: space-between; padding: 23rpx 0; border-bottom: 1rpx solid #efefeb; }.point-row:last-child { border: 0; }.point-row view { display: flex; flex-direction: column; gap: 7rpx; }.point-row text:first-child { font-size: 25rpx; font-weight: 700; }.point-row view text:last-child { color: #979f99; font-size: 19rpx; font-weight: 400; }.point-row > text { color: #c8663c; font-size: 28rpx; font-weight: 800; }
